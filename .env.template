# =============================================================================
# agent-bench environment template
# =============================================================================
# Copy to .env and fill in values. Or run `agent-bench populate-env` to
# auto-populate from 1Password.
#
# To switch profiles, maintain multiple .env files (e.g. .env.prod,
# .env.staging) and symlink or copy the active one to .env.

# === Airbyte Agent MCP ===
AIRBYTE_ORGANIZATION_ID=
AIRBYTE_CLIENT_ID=
AIRBYTE_CLIENT_SECRET=
# Path to OAuth token file (default: ~/.airbyte/agent-mcp-tokens.json)
# Override per profile if different orgs require different OAuth identities.
AIRBYTE_TOKEN_PATH=

# === Connector IDs (Agent MCP) ===
SLACK_CONNECTOR_ID=
LINEAR_CONNECTOR_ID=
GRANOLA_CONNECTOR_ID=
GONG_CONNECTOR_ID=
SALESFORCE_CONNECTOR_ID=
ZENDESK_CONNECTOR_ID=

# === Native MCP: Slack ===
SLACK_BOT_TOKEN=
# Airbyte benchmark workspace team ID: T02TET08MDH
SLACK_TEAM_ID=

# === Native MCP: Linear ===
LINEAR_API_KEY=

# === Native MCP: Gong ===
GONG_ACCESS_KEY=
GONG_ACCESS_KEY_SECRET=

# === Native MCP: Salesforce ===
SF_MCP_CONSUMER_KEY=
SF_MCP_CONSUMER_SECRET=
