# Airbyte org creds (used by the Agent MCP path and recorder).
# Get these from Airbyte Cloud → Settings → Applications.
#
# The client_id/client_secret must belong to the same org specified below;
# mixing credentials from different orgs will return HTTP 401.
AIRBYTE_ORGANIZATION_ID=your-org-uuid
AIRBYTE_CLIENT_ID=your-client-id
AIRBYTE_CLIENT_SECRET=your-client-secret

# Per-connector instance IDs. One per connector wired to your org's Context Store.
SLACK_CONNECTOR_ID=your-slack-connector-uuid
LINEAR_CONNECTOR_ID=your-linear-connector-uuid
GRANOLA_CONNECTOR_ID=your-granola-connector-uuid
GONG_CONNECTOR_ID=your-gong-connector-uuid
SALESFORCE_CONNECTOR_ID=your-salesforce-connector-uuid
ZENDESK_CONNECTOR_ID=your-zendesk-connector-uuid

# Native MCP credentials for third-party servers.
# These are only needed when capturing fresh native-mcp recordings.
# The recording script also checks 1Password (see AGENTS.md); these env vars
# are fallbacks when 1Password is unavailable.

# Salesforce hosted MCP (SObject Reads server).
# Create a Connected App (or External Client App) in your Salesforce org.
# See docs/THIRD_PARTY_MCP_SETUP.md#salesforce-mcp for setup instructions.
SF_MCP_CONSUMER_KEY=your-connected-app-consumer-key
SF_MCP_CONSUMER_SECRET=your-connected-app-consumer-secret
SF_MCP_REFRESH_TOKEN=your-oauth-refresh-token
